# Custom 3-pane layout:
# - left side split into top (larger) + bottom (smaller)
# - right side is one full-height pane
new_tab custom-layout
layout splits

# 1) Base pane (left/top), tagged so we can focus it later
launch --var window=first --title left-top

# 2) Split base vertically to create right full-height pane (narrower)
launch --location=vsplit --bias=25 --title right

# 3) Move focus back to left-top, then split it horizontally for bottom-left
focus_matching_window var:window=first
launch --location=hsplit --bias=30 --title left-bottom
