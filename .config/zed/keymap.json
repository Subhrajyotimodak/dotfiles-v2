[
  // Leader key (Space)
  // Navigation between panes
  { "bindings": { "ctrl-h": "pane::GoLeft" } },
  { "bindings": { "ctrl-j": "pane::GoDown" } },
  { "bindings": { "ctrl-k": "pane::GoUp" } },
  { "bindings": { "ctrl-l": "pane::GoRight" } },

  // Resize panes
  { "bindings": { "ctrl-up": "pane::ResizeUp" } },
  { "bindings": { "ctrl-down": "pane::ResizeDown" } },
  { "bindings": { "ctrl-left": "pane::ResizeLeft" } },
  { "bindings": { "ctrl-right": "pane::ResizeRight" } },

  // Buffer navigation
  { "bindings": { "shift-l": "pane::GoForward" } },
  { "bindings": { "shift-h": "pane::GoBackward" } },

  // Move lines up/down
  { "bindings": { "alt-j": "editor::MoveLineDown" } },
  { "bindings": { "alt-k": "editor::MoveLineUp" } },

  // LSP Keybindings
  { "bindings": { "g f": "editor::GoToReferences" } },
  { "bindings": { "g d": "editor::GoToDefinition" } },
  { "bindings": { "g i": "editor::GoToImplementation" } },
  { "bindings": { "shift-k": "editor::Hover" } },

  // Diagnostics
  { "bindings": { "[d": "editor::GoToPreviousError" } },
  { "bindings": { "]d": "editor::GoToNextError" } },

  // Leader (Space) based commands
  { "bindings": { "space w": "workspace::Save" } },
  { "bindings": { "space n h": "editor::ToggleLineNumbers" } },
  { "bindings": { "space e": "workspace::ToggleLeftPanel" } },
  { "bindings": { "space f f": "file_finder::Toggle" } },
  { "bindings": { "space f g": "file_finder::ToggleGit" } },
  { "bindings": { "space f b": "buffer_picker::Toggle" } },
  { "bindings": { "space f s": "project_search::Toggle" } },
  { "bindings": { "space space": "editor::Format" } },
  { "bindings": { "space t": "editor::CodeActions" } },
  { "bindings": { "space r n": "editor::Rename" } },
  { "bindings": { "space l": "editor::RevealDiagnostics" } },
  { "bindings": { "space k": "editor::RevealDiagnostics" } },
  { "bindings": { "space q": "editor::RevealDiagnostics" } },
  { "bindings": { "space o": "outline::Toggle" } },

  // Delete without copying
  { "bindings": { "x": "editor::Delete" } },
]
