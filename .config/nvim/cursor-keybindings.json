[
  // Paste this into: Cursor -> Keyboard Shortcuts -> Open Keyboard Shortcuts (JSON)
  //
  // Notes:
  // - If you use VSCodeVim, many "leader" mappings live in settings.json under vim.*.
  // - These keybindings are for non-Vim contexts (or to make navigation work even outside Normal mode).

  {
    "key": "ctrl+h",
    "command": "workbench.action.focusLeftGroup",
    "when": "editorTextFocus && vim.active && vim.mode != 'Normal'"
  },
  {
    "key": "ctrl+j",
    "command": "workbench.action.focusBelowGroup",
    "when": "editorTextFocus && vim.active && vim.mode != 'Normal'"
  },
  {
    "key": "ctrl+k",
    "command": "workbench.action.focusAboveGroup",
    "when": "editorTextFocus && vim.active && vim.mode != 'Normal'"
  },
  {
    "key": "ctrl+l",
    "command": "workbench.action.focusRightGroup",
    "when": "editorTextFocus && vim.active && vim.mode != 'Normal'"
  },

  {
    "key": "space e",
    "command": "workbench.view.explorer"
  },
  {
    "key": "space f f",
    "command": "workbench.action.quickOpen"
  },
  {
    "key": "space f g",
    "command": "workbench.action.findInFiles"
  },
  {
    "key": "space g s",
    "command": "workbench.view.scm"
  },
  {
    "key": "space t",
    "command": "workbench.action.terminal.toggleTerminal"
  }
]
