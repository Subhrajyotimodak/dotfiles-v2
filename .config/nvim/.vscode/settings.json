{
  // --- Editor defaults (Neovim-ish) ---
  "editor.lineNumbers": "relative",
  "editor.cursorStyle": "line",
  "editor.cursorBlinking": "phase",
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "selection",
  "editor.scrollBeyondLastLine": false,
  "editor.smoothScrolling": true,
  "workbench.editor.enablePreview": false,
  "workbench.editor.enablePreviewFromQuickOpen": false,

  // --- Explorer / files ---
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.simpleDialog.enable": true,

  // --- Search ---
  "search.useIgnoreFiles": true,
  "search.useGlobalIgnoreFiles": true,

  // --- Terminal ---
  "terminal.integrated.scrollback": 10000,

  // --- VSCodeVim (install the "Vim" extension by vscodevim) ---
  "vim.useSystemClipboard": true,
  "vim.leader": "<space>",
  "vim.hlsearch": true,
  "vim.incsearch": true,
  "vim.smartRelativeLine": true,
  "vim.sneak": true,
  "vim.camelCaseMotion.enable": true,

  // Common "jk" escape (remove if you don't want it)
  "vim.insertModeKeyBindings": [
    {
      "before": ["j", "k"],
      "after": ["<esc>"]
    }
  ],

  // Leader mappings (telescope/explorer/buffers/splits/git/terminal)
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": ["<leader>", "f", "f"],
      "commands": ["workbench.action.quickOpen"]
    },
    {
      "before": ["<leader>", "f", "g"],
      "commands": ["workbench.action.findInFiles"]
    },
    {
      "before": ["<leader>", "f", "b"],
      "commands": ["workbench.action.showAllEditorsByMostRecentlyUsed"]
    },
    { "before": ["<leader>", "e"], "commands": ["workbench.view.explorer"] },
    { "before": ["<leader>", "g", "s"], "commands": ["workbench.view.scm"] },
    {
      "before": ["<leader>", "t"],
      "commands": ["workbench.action.terminal.toggleTerminal"]
    },

    {
      "before": ["<leader>", "w"],
      "commands": ["workbench.action.files.save"]
    },
    {
      "before": ["<leader>", "q"],
      "commands": ["workbench.action.closeActiveEditor"]
    },

    {
      "before": ["<leader>", "b", "n"],
      "commands": ["workbench.action.nextEditor"]
    },
    {
      "before": ["<leader>", "b", "p"],
      "commands": ["workbench.action.previousEditor"]
    },
    {
      "before": ["<leader>", "b", "d"],
      "commands": ["workbench.action.closeActiveEditor"]
    },

    {
      "before": ["<leader>", "s", "v"],
      "commands": ["workbench.action.splitEditorRight"]
    },
    {
      "before": ["<leader>", "s", "s"],
      "commands": ["workbench.action.splitEditorDown"]
    },
    {
      "before": ["<leader>", "s", "q"],
      "commands": ["workbench.action.closeActiveEditor"]
    },
    {
      "before": ["<leader>", "s", "o"],
      "commands": ["workbench.action.closeOtherEditors"]
    },

    // Quick window navigation (tmux/vim-style)
    { "before": ["<C-h>"], "commands": ["workbench.action.focusLeftGroup"] },
    { "before": ["<C-j>"], "commands": ["workbench.action.focusBelowGroup"] },
    { "before": ["<C-k>"], "commands": ["workbench.action.focusAboveGroup"] },
    { "before": ["<C-l>"], "commands": ["workbench.action.focusRightGroup"] }
  ]
}
